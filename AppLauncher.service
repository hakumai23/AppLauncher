[Unit]
Description=Next.js AppLauncher service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/AppLauncher
ExecStart=/home/hakumai23/.nvm/versions/node/v25.9.0/bin/npm run start
Environment=NODE_ENV=production
Environment=PORT=3000
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
